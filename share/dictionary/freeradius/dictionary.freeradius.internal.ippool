#
#	Attributes used by IP-Pool modules (5100-5199)
#
#	$Id$
#

#
#	All of these attributes are internal.
#
FLAGS	internal

ATTRIBUTE	IP-Pool					5100	tlv

BEGIN 	IP-Pool
ATTRIBUTE	Name					1	string	# Generic identifier for the IP pool to allocate from
ATTRIBUTE	Name-NA					2	string	# DHCPv6 - Non-Temporary association pool
ATTRIBUTE	Name-PD					3	string	# DHCPv6 - Prefix-deligation pool
ATTRIBUTE	Name-TA					4	string	# DHCPv6 - Temporary association pool

ATTRIBUTE	Range					6	string

ATTRIBUTE	Lease					7	tlv

BEGIN	Lease
ATTRIBUTE	Address					1	string
ATTRIBUTE	Active					2	bool
ATTRIBUTE	Expires					3	date
ATTRIBUTE	Device					4	string
ATTRIBUTE	Gateway					5	string
ATTRIBUTE	Range					6	string
END	Lease

ATTRIBUTE	Stats					8	tlv

BEGIN	Stats
ATTRIBUTE	Total					1	uint64
ATTRIBUTE	Dynamic					2	tlv

BEGIN	Dynamic
ATTRIBUTE	Total					1	uint64
ATTRIBUTE	Free					2	uint64
ATTRIBUTE	Expire-1m				3	uint64
ATTRIBUTE	Expire-30m				4	uint64
ATTRIBUTE	Expire-1h				5	uint64
ATTRIBUTE	Expire-1d				6	uint64
END	Dynamic

ATTRIBUTE	Static					3	tlv

BEGIN	Static
ATTRIBUTE	Total					1	uint64
ATTRIBUTE	Free					2	uint64
ATTRIBUTE	Renew-1m				3	uint64
ATTRIBUTE	Renew-30m				4	uint64
ATTRIBUTE	Renew-1h				5	uint64
ATTRIBUTE	Renew-1d				6	uint64
END	Static

END	Stats

END		IP-Pool
