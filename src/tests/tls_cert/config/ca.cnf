#
#  Minimal configuration for "openssl ca", to make a self-signed
#  certificate which has already expired.
#
[ ca ]
default_ca		= CA_default

[ CA_default ]
dir			= $ENV::TLS_CERT_OUT
database		= $dir/index.txt
new_certs_dir		= $dir
serial			= $dir/serial
default_md		= sha256
policy			= policy_any
unique_subject		= no
x509_extensions		= v3_ca

[ policy_any ]
commonName		= supplied

[ v3_ca ]
basicConstraints	= critical,CA:true

[ req ]
prompt			= no
distinguished_name	= req_dn

[ req_dn ]
commonName		= Test certificate
