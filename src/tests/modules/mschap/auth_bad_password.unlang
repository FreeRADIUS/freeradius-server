#
#  The MS-CHAPv1 response was calculated with the password
#  "supersecret".  A different known password must reject.
#
control.Password.Cleartext := "notthepassword"

mschap

if !(control.Auth-Type == ::mschap) {
	test_fail
}

mschap.authenticate {
	reject = 1
}

if !(reject) {
	test_fail
}

#
#  691 is the MS-CHAP "authentication failure" error code.  The
#  error starts with the ident byte, which is NUL here.  POSIX regex
#  refuses strings that contain a NUL, so compare a substring.
#
if !(%str.substr(reply.Vendor-Specific.Microsoft.CHAP-Error, 1, 6) == 'E=691 ') {
	test_fail
}

reply -= Vendor-Specific.Microsoft.CHAP-Error

test_pass
