#
#  Sessions with different dedup keys don't replace each other.  With
#  max_sessions = 1, the second session can't be stored.
#
eap.authenticate {
	fail = 1
	handled = 1
}
if (!&reply:State) {
	test_fail
}

update reply {
	&EAP-Message !* ANY
	&Message-Authenticator !* ANY
	&State !* ANY
}

update request {
	&Calling-Station-Id := "02-00-00-00-00-02"
}

eap.authenticate {
	fail = 1
	handled = 1
}
if (&reply:State) {
	test_fail
}
else {
	update reply {
		&Filter-Id := "not stored"
	}
	test_pass
}

update reply {
	&EAP-Message !* ANY
	&Message-Authenticator !* ANY
}
