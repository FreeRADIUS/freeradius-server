server eap-tls-test {
	namespace = tls

	load session {
		cache_tls_session
	}

	store session {
		cache_tls_session
	}

	clear session {
		cache_tls_session
	}

	verify certificate {
		if (Session-Resumed == true) {
			reject
		}

		#
		#  Ensure we have access to the certificate attributes
		#
		if (!parent.session-state.TLS-Certificate[0].Issuer) {
			reject
		}
	}
}
