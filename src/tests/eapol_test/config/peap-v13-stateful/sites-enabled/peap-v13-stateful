server inner-tunnel {
	namespace = radius

recv Access-Request {
	copy_request_to_tunnel
	filter_username
	filter_inner_identity

	split_username_nai
	control.Password.Cleartext := Stripped-User-Name

	chap
	mschap
	eap {
		ok = return
	}

	files

	pap
}

authenticate pap {
	pap
}

authenticate chap {
	chap
}

authenticate mschap {
	mschap
}

authenticate eap {
	eap
}

send Access-Accept {
	ok
}

send Access-Reject {
	ok
}
}

#
#  The `tls` virtual server which holds the session cache sections.  The server keeps the session,
#  and a TLS 1.3 stateful ticket holds only the session ID.  `store session` runs when the ticket
#  is issued, and `load session` runs when the peer presents the ID.
#
server peap-v13-stateful-tls {
	namespace = tls

	load session {
		cache_tls_session
	}

	store session {
		cache_tls_session
	}

	clear session {
		cache_tls_session
	}
}
