#
# PRE: edit-list
#

request += {
	Class = 0x00
	Filter-Id = "foo"
	NAS-Port = 1
}

#  Does exist
if (!Filter-Id) {
	test_fail
}

# Remove the first one
request -= Filter-Id

#  Does not exist
if (Filter-Id) {
	test_fail
}

# Other things still exist
if (!Class) {
	test_fail
}

if (!NAS-Port) {
	test_fail
}

#
#  Add multiple of the same type
#
request += {
	Filter-Id = "foo"
	Filter-Id = "bar"
	Filter-Id = "baz"
}

if (!Filter-Id) {
	test_fail
}

request -= Filter-Id[0]

#  the first one has been removed
if (!(Filter-Id[0] == "bar")) {
	test_fail
}

# Other things still exist
if (!Class) {
	test_fail
}

if (!NAS-Port) {
	test_fail
}

request -= Filter-Id[*]

# Does not exist
if (Filter-Id) {
	test_fail
}

Filter-Id := { "foo", "bar", "baz" }

#
#  Remove one by value.
#
#  @todo - allow for == or =~ in the RHS list,
#  as a condition?  For now, it's an exact match. :(
#
request -= {
	Filter-Id == "bar"
}

if (!(Filter-Id[0] == "foo")) {
	test_fail
}

if (!(Filter-Id[1] == "baz")) {
	test_fail
}

if (Filter-Id[2]) {
	test_fail
}

#
#  Remove via in-place list, too.
#
request -= "Filter-Id == 'foo'"
if (!(Filter-Id[0] == "baz")) {
	test_fail
}

if (Filter-Id[1]) {
	test_fail
}

request += { Vendor-Specific.Cisco.AVPair = "foo" }

#
#  Test removal of a child of a structural attribute
#
request.Vendor-Specific -= Cisco

if (request.Vendor-Specific.Cisco) {
	test_fail
}

#
#  Check the empty parent has been removed
#
if (request.Vendor-Specific) {
	test_fail
}

#
#  The same thing, but with the RHS written out in full.
#
request += { Vendor-Specific.Cisco.AVPair = "foo" }

request.Vendor-Specific -= request.Vendor-Specific.Cisco

if (request.Vendor-Specific.Cisco) {
       test_fail
}

#
#  Test removal of a member of a child of a structural attribute
#
request += { Vendor-Specific.Cisco.AVPair = "foo" }

request.Vendor-Specific -= Cisco.AVPair

if (request.Vendor-Specific) {
       test_fail
}

#
#  Removing one child will leave the other and parent
#
request += { Vendor-Specific.Cisco.AVPair = "foo" }
request.Vendor-Specific += { Nokia.AVPair = "baa" }

request -= Vendor-Specific.Cisco.AVPair

if (request.Vendor-Specific.Cisco) {
	test_fail
}

if (!request.Vendor-Specific.Nokia) {
	test_fail
}

success
