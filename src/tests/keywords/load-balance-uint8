#
#  PRE: load-balance
#

#
#  Test the situation of forcing the load-balance key
#
uint8 key

#
#  Do this a bunch of times to be sure that it's OK,
#  and if any one test fails, return.  That way we don't have
#  100's of errors when something goes wrong.
#
foreach i (%range(50)) {
key := 0
load-balance %{key} {
	group {
		if (%interpreter.load-balance.child() != key) {
			test_fail
			return
		}
		ok
	}
	test_fail
	test_fail
	test_fail
}
if (!ok) {
	return
}

key := 1
load-balance %{key} {
	test_fail
	group {
		if (%interpreter.load-balance.child() != key) {
			test_fail
			return
		}
		ok
	}

	test_fail
	test_fail
}
if (!ok) {
	return
}

key := 2
load-balance %{key} {
	test_fail
	test_fail
	group {
		if (%interpreter.load-balance.child() != key) {
			test_fail
			return
		}
		ok
	}

	test_fail
}
if (!ok) {
	return
}

key := 3
load-balance %{key} {
	test_fail
	test_fail
	test_fail
	group {
		if (%interpreter.load-balance.child() != key) {
			test_fail
			return
		}
		ok
	}

}
if (!ok) {
	return
}

#
#  A key equal to the number of children is out of range, and the
#  child is chosen by hashing the key instead.
#
key := 4
load-balance %{key} {
	group {
		if (%interpreter.load-balance.child() != 0) {
			test_fail
			return
		}
		ok
	}
	group {
		if (%interpreter.load-balance.child() != 1) {
			test_fail
			return
		}
		ok
	}
	group {
		if (%interpreter.load-balance.child() != 2) {
			test_fail
			return
		}
		ok
	}
	group {
		if (%interpreter.load-balance.child() != 3) {
			test_fail
			return
		}
		ok
	}
}
if (!ok) {
	return
}

} # foreach

success
