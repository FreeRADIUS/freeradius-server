timeout: {{ test_timeout }}
state_order: sequence
states:
  state_1:
    description: >
      The load generator sends Access-Requests to
      {{ compose_num_of_home_servers }} home servers, and each home server accepts every request.
      Because the test configuration sets `complete: exit`, the load generator shuts down when
      the load completes.

      The `server.stop` trigger will run the `check-status.sh` script to check
      the Status-Server stats.

      In profiling mode the state runs until timeout is reached to ensure the scripts
      have enough time to write the profiling results.  Setting timeout_mode to `bound`
      could result in the test ending before the profiling results are written.
    host:
      load-generator:
        actions:
        - execute_command:
            command: |
              #
              # proto_load configuration via environment variables
              #
              {% for key, value in loadgen.items() %}
              export TEST_LOADGEN_{{ key | upper }}="{{ value }}"
              {% endfor %}

              exec ${RADIUSD_COMMAND:-freeradius -f -l stdout}

            detach: true
    verify:
      timeout: {{ test_verify_timeout }}
      timeout_mode: {{ 'window' if mode == 'profiling' else 'bound' }}
      trigger_mode: unordered
      triggers:
      - load-generator-status-server:
          json:
            Status-Server-Result:
              pattern:
                reg_pattern: PASS
            Access-Request-Counter:
              pattern:
                reg_pattern: (\d+)
            Access-Accept-Counter:
              pattern:
                reg_pattern: (\d+)
