timeout: {{ test_timeout }}
state_order: sequence
states:
  state_1:
    description: >
      Baseline load-generator test for load-generator ->
      {{ compose_num_of_proxy_servers }} proxy ->
      {{ compose_num_of_home_servers }} home servers. Home servers auto-accept requests.
      Because the test configuration sets `complete: exit`, the load generator shuts down when
      the load completes.

      The `server.stop` trigger then runs the `check-status.sh` script which sends the
      Status-Server request to the load-generator. The `recv Status-Server` section of
      the server generates the `load-generator-status-server` trigger with PASS or FAIL.
    host:
      load-generator:
        actions:
        - execute_command:
            command: |
              #
              # proto_load configuration via environment variables
              #
              {% for key, value in loadgen.items() %}
              export TEST_LOADGEN_{{ key | upper }}="{{ value }}"
              {% endfor %}

              exec ${RADIUSD_COMMAND:-freeradius -f -l stdout}

            detach: true
    verify:
      timeout: {{ test_verify_timeout }}
      timeout_mode: bound
      trigger_mode: unordered
      triggers:
      - load-generator-status-server:
          json:
            Status-Server-Result:
              pattern:
                reg_pattern: PASS
            Access-Request-Counter:
              pattern:
                reg_pattern: (\d+)
            Access-Accept-Counter:
              pattern:
                reg_pattern: (\d+)
