{#
  include_at(name, depth): include a compose snippet and indent every line
  of the result by depth spaces.  Snippets are written at column zero, so
  the including file decides where they sit.  Import with context, so the
  snippet sees the same variables as the file that includes it:

    {% import "compose/macros.j2" as compose with context %}
    ...
    environment:
{{ compose.include_at("compose/freeradius/profiling-environment.yml.j2", 6) }}
#}
{% macro include_at(name, depth) %}{% filter indent(depth, first=True) %}{% include name %}{% endfilter %}{% endmacro %}
