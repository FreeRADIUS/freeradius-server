# ---------------------------------------------------------------
# Docker Compose Test Environment:
#
#   load-generator (proto_load, in-process) -> FreeRADIUS -> openldap
#
#   Same compose serves both service and profiling modes; see
#   environments/accept.yml.j2 for the FREERADIUS_IMAGE / PROFILING
#   convention.
# ---------------------------------------------------------------
{% import "compose/macros.j2" as compose with context %}
x-common-config: &id001
  cap_add:
  - NET_ADMIN
  - SYS_PTRACE
  environment:
    TEST_PROJECT_NAME: ${COMPOSE_PROJECT_NAME}
    TEST_SUBNET: {{ test_subnet | default('172.16.0.0/12') }}
services:
  openldap:
    image: dinkel/openldap:latest
    environment:
      SLAPD_DOMAIN: "example.com"
      SLAPD_PASSWORD: "adminpassword"
      SLAPD_ORGANIZATION: "Example"
    volumes:
    # dinkel's entrypoint slapadds any *.ldif under /etc/ldap/prepopulate
    # on first start. It iterates the files via slapadd directly, no
    # in-place sed/chown/rm shenanigans, so a read-only bind-mount of the
    # parent dir survives the init unscathed.
    - ${DATA_PATH}/openldap/bootstrap:/etc/ldap/prepopulate:ro
    healthcheck:
      # dinkel doesn't ship ldap-utils; probe the listener via bash's
      # built-in /dev/tcp so we don't need ldapsearch in the image.
      test: ["CMD-SHELL", "bash -c '</dev/tcp/localhost/389'"]
      interval: 2s
      timeout: 5s
      retries: 15
      start_period: 15s
    <<: *id001
  freeradius:
    image: ${FREERADIUS_IMAGE}
    environment:
{{ compose.include_at("compose/freeradius/profiling-environment.yml.j2", 6) }}
    depends_on:
      openldap:
        condition: service_healthy
    volumes:
    # freeradius server config
    - ${DATA_PATH}/freeradius/ldap/radiusd.conf:/etc/freeradius/radiusd.conf
{{ compose.include_at("compose/freeradius/load-generator-volumes.yml.j2", 4) }}
{{ compose.include_at("compose/freeradius/profiling-volumes.yml.j2", 4) }}
{{ compose.include_at("compose/freeradius/listener-volumes.yml.j2", 4) }}
    entrypoint:
    - bash
    - -lc
    - |
      # Keep the container alive. The test framework starts FreeRADIUS
      # and runs commands via 'docker exec' so it can control timing.
      sleep infinity
    <<: *id001

