#######################################################################
#
#  = The redis Virtual Server
#
#  The `redis` virtual server handles the fetching of Redis cluster maps
#
#  It is called from the rlm_redis module when a cluster map is needed
#  either when connections are first established or in response to a
#  Redis MOVED reply.
#
#  This virtual server has no process sections.
#
#  == The Virtual Server
#
#  This is the `redis` virtual server.
#
server redis {
	namespace = redis

	redis {
		#
		#  timeout:: Timeout when fetching cluster map
		#
#		timeout = 5s

		#
		#  retry_interval:: Time between retrying a failed map fetch
		#
#		retry_interval = 30s

		#
		#  pool:: Connection pool settings
		#
		#  The `redis` virtual server uses pool configuration
		#  with the same options as the rlm_redis module.
		#
		#  The default values are reasonable for most settings
		#  thought the connection_timeout / reconnect_delay may
		#  need to be amended.
		pool {
			connection {
				#
				#  connection_timeout:: How long to wait
				#  before giving up on a connection which is
				#  being opened.
				#
#				connection_timeout = 3.0

				#
				#  reconnect_delay:: If opening a connection
				#  fails, or an open connection fails,
				#  we wait `reconnect_delay` seconds before
				#  attempting to open another connection.
				#
#				reconnect_delay = 5
			}
		}
	}
}
