#  -*- text -*-
######################################################################
#
#	An example virtual server for EAP-PSK (RFC 4764).
#
#	EAP-PSK is a mutual-authentication EAP method built on a
#	16-octet pre-shared key.  The peer asserts an identity during
#	authentication, and this virtual server looks up the key for
#	that identity.
#
#	Keys should be generated from a secure random source, e.g.
#
#		dd if=/dev/urandom bs=16 count=1 | xxd -p
#
#	To use this server, enable it, and reference it from the psk
#	section of mods-available/eap:
#
#		psk {
#			virtual_server = eap-psk
#		}
#
######################################################################
server eap-psk {
	namespace = eap-psk

	eap-psk {
		#  identity:: The server identity (ID_S) sent to the peer.
		#
		#  This should generally be the host name of the RADIUS
		#  server, or some other information which uniquely
		#  identifies it.
		#
		identity = "FreeRADIUS"
	}

	#
	#  Runs before the first message is sent.  To override the
	#  configured server identity for this session, set:
	#
	#	reply.Server-Identity := "aaa1.example.com"
	#
	send Identity-Request {
	}

	#
	#  Runs when the peer has asserted its identity.  Look up the
	#  pre-shared key for that identity, and add the key as
	#  control.Password.PSK.  The key must be exactly 16 octets.
	#
	#  If no key is added, the message is silently discarded, so
	#  probing for valid identities is not possible.  To send an
	#  explicit failure instead, set:
	#
	#	reply.Packet-Type := ::Failure
	#
	recv Identity-Response {
		#
		#  Keys are usually stored in a file or database, keyed
		#  by the peer identity, e.g.
		#
		#	control.Password.PSK := %sql("SELECT psk FROM psk_keys WHERE identity = '%{Identity}'")
		#
		if (Identity == "bob@example.org") {
			control.Password.PSK := 0x000102030405060708090a0b0c0d0e0f
			ok
		}
		else {
			notfound
		}
	}

	#
	#  Runs before the third message, which proves the server also
	#  holds the key, and tells the peer authentication succeeded.
	#
	send Result-Indication {
	}

	#
	#  Runs when the peer confirms mutual authentication.
	#
	recv Result-Acknowledgement {
	}

	#
	#  Run before the final EAP-Success or EAP-Failure is sent.
	#
	send Success {
	}

	send Failure {
	}
}
