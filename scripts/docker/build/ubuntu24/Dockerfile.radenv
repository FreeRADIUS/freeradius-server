# Auto generated for ubuntu24
# from scripts/docker/m4/radenv.deb.m4
#
# Rebuild this file with `make dockerfile.radenv`
#
ARG from=ubuntu:24.04
FROM ${from}

#
#  The 'radenv' image holds a developer build of FreeRADIUS from the
#  checkout, and the multi-server tests build the 'radenv' image for each
#  commit.  The crossbuild base image provides the toolchain, the build
#  dependencies, and the packages whose commands the tests run.  A build
#  of the 'radenv' image therefore only compiles and installs FreeRADIUS
#  from the checkout.  The build does not run `apt-get`, so an
#  unreachable package mirror does not stop the build.
#
#
#  Build FreeRADIUS from the local checkout and install FreeRADIUS into a
#  'radenv' image.  The crossbuild base image already provides the build
#  dependencies and a clone of the upstream source at
#  `/usr/local/src/repositories/freeradius-server`.  The `COPY` below
#  writes the local checkout over the clone, so the image holds the
#  branch under test, not the upstream 'master' at image build time.
#
#  The template that includes `common.radenv-build.m4` defines the m4
#  macro `RADENV_CONFIGURE_ARGS`, the extra configure arguments for the
#  image.  Put each argument on its own line, and end each line with a
#  space and a backslash.  An empty definition passes no extra arguments,
#  so configure runs with only the developer build arguments below.
#
WORKDIR /usr/local/src/repositories/freeradius-server
COPY . .

# Wipe any host build artefacts that survived the COPY before invoking
# autoconf/make so the container builds from a clean state. The
# libbacktrace submodule in particular tends to carry host-absolute
# paths in its generated Makefile / libtool.
RUN rm -rf build autom4te.cache .libs config.log config.status \
        src/lib/backtrace/Makefile src/lib/backtrace/config.log \
        src/lib/backtrace/config.status src/lib/backtrace/libtool \
        src/lib/backtrace/.libs src/lib/backtrace/*.la \
        src/lib/backtrace/*.lo
#
#  --prefix=/usr puts binaries under /usr/{bin,sbin}, libraries under
#  /usr/lib, etc. so the radenv image's filesystem layout matches
#  the production deb/rpm packages. Test fixtures and scripts can use
#  the same absolute paths (e.g. /usr/bin/radclient) in either mode.
#
RUN ./configure \
        --prefix=/usr \
        --enable-developer \
        --with-raddbdir=/etc/freeradius \
    && make -j$(nproc) \
    && make install

#
#  Provide `freeradius` / `freeradius.conf` / `/etc/raddb` aliases so
#  test scripts and configs match the names used by the production
#  packages.
#
RUN ln -sf /usr/sbin/radiusd /usr/sbin/freeradius \
 && ln -sf /etc/freeradius/radiusd.conf /etc/freeradius/freeradius.conf \
 && ln -sf /etc/freeradius /etc/raddb

#
#  Generate the self-signed RSA (and DH/EC) certificates the test
#  fixtures expect.
#
RUN cd /etc/freeradius/certs && make

#
#  Stage the same docker-entrypoint.sh the service image uses. Docker
#  compose fixtures (e.g. src/tests/multi-server/environments/) override
#  ENTRYPOINT but still exec /docker-entrypoint.sh from inside their
#  wrapper, so the file needs to exist at the root in every image that
#  the tests run.
#
WORKDIR /
COPY scripts/docker/etc/docker-entrypoint.sh.deb docker-entrypoint.sh
RUN chmod +x docker-entrypoint.sh

EXPOSE 1812/udp 1813/udp
CMD ["/bin/sh", "-c", "while true; do sleep 60; done"]
